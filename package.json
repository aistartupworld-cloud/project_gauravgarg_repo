{
  "name": "securegate",
  "version": "1.0.0",
  "private": true,
  "description": "SecureGate - Compliance Audit, Findings & Remediation Platform (BC-AINE-015)",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "npm run build:web && tsx server/src/main.ts",
    "dev:server": "tsx watch server/src/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:api": "vitest run tests/api",
    "test:arch": "vitest run tests/architecture && npm run lint:deps",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint:deps": "depcruise server/src web/src --config .dependency-cruiser.cjs",
    "ac:trace": "tsx scripts/ac-trace.ts",
    "agent:review": "tsx scripts/agent-review.ts",
    "migrations:lock": "tsx scripts/migrations-lock.ts"
  },
  "dependencies": {
    "express": "^4.22.3"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.308",
    "@playwright/test": "1.56",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "dependency-cruiser": "^18.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
